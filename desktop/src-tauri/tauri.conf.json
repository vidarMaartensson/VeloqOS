{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Veloq OS",
  "version": "0.1.0",
  "identifier": "com.vidarmartensson.veloqos",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:7470",
    "beforeDevCommand": "bash scripts/build-api.sh --if-missing && npm --prefix ../web run dev",
    "beforeBuildCommand": "bash scripts/build-api.sh && npm --prefix ../web run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/veloq-api"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    }
  }
}
